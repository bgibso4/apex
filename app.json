{
  "expo": {
    "name": "APEX",
    "slug": "apex",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "apex",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bgibso4.apex",
      "appleTeamId": "W6S6K84XVM",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/withICloudBackup",
      "expo-font",
      "expo-sharing",
      ["expo-splash-screen", { "backgroundColor": "#0a0a0f" }],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
