{
  "name": "apex",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "typecheck": "npx tsc --noEmit",
    "prebuild": "npx expo prebuild --platform ios",
    "device": "npx expo run:ios --device --configuration Release",
    "device:clean": "npx expo prebuild --clean --platform ios && npx expo run:ios --device --configuration Release"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/theme/index.ts",
      "!src/db/database.ts",
      "!src/**/types.ts",
      "!src/types/**",
      "!src/db/index.ts"
    ],
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/.worktrees/"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/.worktrees/"
        ],
        "testMatch": [
          "**/__tests__/utils/**",
          "**/__tests__/db/**",
          "**/__tests__/data/**"
        ],
        "moduleNameMapper": {
          "^expo-file-system/legacy$": "expo-file-system",
          "\\.(ttf|otf|woff|woff2)$": "<rootDir>/__mocks__/fileMock.js"
        },
        "transform": {
          "^.+\\.(ts|tsx)$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        },
        "transformIgnorePatterns": [
          "node_modules/(?!@cadre/shared)"
        ]
      },
      {
        "displayName": "components",
        "preset": "@react-native/jest-preset",
        "resolver": "react-native-reanimated/jest/resolver.js",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/.worktrees/"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/.worktrees/"
        ],
        "moduleNameMapper": {
          "^react-native-svg$": "<rootDir>/__mocks__/react-native-svg.ts",
          "\\.(ttf|otf|woff|woff2)$": "<rootDir>/__mocks__/fileMock.js"
        },
        "testMatch": [
          "**/__tests__/components/**",
          "**/__tests__/hooks/**"
        ],
        "transform": {
          "^.+\\.(js|ts|tsx)$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        },
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@cadre/shared)"
        ]
      },
      {
        "displayName": "health",
        "testEnvironment": "node",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/.worktrees/"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/.worktrees/"
        ],
        "testMatch": [
          "**/__tests__/health/**"
        ],
        "moduleNameMapper": {
          "\\.(ttf|otf|woff|woff2)$": "<rootDir>/__mocks__/fileMock.js"
        },
        "transform": {
          "^.+\\.(ts|tsx)$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        }
      },
      {
        "displayName": "sync",
        "testEnvironment": "node",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/.worktrees/"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/.worktrees/"
        ],
        "testMatch": [
          "**/__tests__/sync/**"
        ],
        "moduleNameMapper": {
          "\\.(ttf|otf|woff|woff2)$": "<rootDir>/__mocks__/fileMock.js"
        },
        "transform": {
          "^.+\\.(ts|tsx)$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        },
        "transformIgnorePatterns": [
          "node_modules/(?!@cadre/shared)"
        ]
      }
    ]
  },
  "dependencies": {
    "@cadre/shared": "github:bgibso4/cadre#v0.1.0",
    "@expo/vector-icons": "^15.0.3",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.20",
    "expo-auth-session": "~58.0.17",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  }
}
